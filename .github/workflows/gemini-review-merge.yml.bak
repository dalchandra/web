name: Gemini PR Review and Merge

on:
  pull_request_target:
    types: [opened, synchronize, reopened]

jobs:
  review-and-merge:
    uses: ./.github/workflows/_pr-review-merge.yml
    with:
      provider: gemini
      # Resolved from the target repo's MODEL Actions variable, not a
      # commit -- orchestrate_github_pr.py's --model-map sets this via
      # `gh variable set` before each model's trials (see ../README.md).
      # Falls back to the current default per ../../MODELS.md if unset --
      # NOT the real repo's original gemini-2.5-flash, confirmed
      # deprecated (the whole 2.5 line shut down 2026-10-16).
      model: ${{ vars.MODEL || 'gemini-3.1-flash-lite' }}
      pip_packages: google-genai
      # Resolved from the target repo's SYSTEM_PROMPT_VARIANT Actions
      # variable, not a commit -- orchestrate_github_pr.py sets this via
      # `gh variable set` before each run (see ../README.md). Falls back
      # to 'general' if unset.
      system_prompt_variant: ${{ vars.SYSTEM_PROMPT_VARIANT || 'general' }}
    secrets:
      api_key: ${{ secrets.GEMINI_API_KEY }}
